# Precisely API key; keep actual credentials in your local .env only.
PRECISELY_API_KEY=
# Precisely API secret; never commit the actual value.
PRECISELY_API_SECRET=
# Precisely API base URL.
PRECISELY_BASE_URL=https://api.precisely.com
# Groq API key; keep the actual value in local .env only.
GROQ_API_KEY=
# Groq model identifier.
GROQ_MODEL=openai/gpt-oss-120b
# Groq model used only for exception cause diagnosis.
REMEDIATION_MODEL=openai/gpt-oss-20b
# Maximum Groq token usage per UTC day.
GROQ_DAILY_TOKEN_BUDGET=180000
# Independent Groq cause classifications sampled per policy record.
# Optional: overrides the client profile (config/client_profile.yaml) when set.
# REMEDIATION_SAMPLES=5
# Miscoverage target used for split-conformal calibration.
# Optional: overrides the client profile (config/client_profile.yaml) when set.
# CONFORMAL_ALPHA=0.10
# Maximum cumulative credit spend across runs.
CREDIT_HARD_CAP=2150
# Total credits available in the trial account.
TRIAL_CREDITS=2500
# Standard-library logging level.
LOG_LEVEL=INFO
