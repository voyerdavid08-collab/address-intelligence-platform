# Precisely API key; keep actual credentials in your local .env only.
PRECISELY_API_KEY=
# Precisely API secret; never commit the actual value.
PRECISELY_API_SECRET=
# Precisely API base URL.
PRECISELY_BASE_URL=https://api.precisely.com
# Maximum cumulative credit spend across runs.
CREDIT_HARD_CAP=2150
# Standard-library logging level.
LOG_LEVEL=INFO
